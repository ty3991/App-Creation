# Never commit real secrets. The start command reads ../.env.local locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# Rules is the default and never calls an AI provider, even when a key exists.
# Set openai only after confirming credits/costs. Local Windows launcher always uses rules.
AI_MODE=rules
AI_DISABLED=0
MAX_UPLOAD_STORAGE_MB=512
HOST=127.0.0.1
PORT=4173
PUBLIC_ORIGIN=http://localhost:4173
DATA_DIR=./data
PRINTER_X=256
PRINTER_Y=256
PRINTER_Z=256
# Use HTTPS and a durable mounted DATA_DIR for production.
